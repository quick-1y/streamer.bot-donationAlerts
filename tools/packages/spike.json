      "precompile": true,
      "delayStart": false
    },
    {
      "key": "b",
      "name": "DaSpikeB",
      "source": "spike/DaSpikeB.cs",
      "description": "DonationAlerts live spike B",
      "precompile": true,
      "delayStart": false
    }
  ],
  "actions": [
